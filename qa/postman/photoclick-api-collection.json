    {
      "name": "11 - Gallery / Images",
      "item": [
        {
          "name": "Get Images",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/getImages"
          }
        },
        {
          "name": "Upload Images (Admin)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": [],
                  "description": "Select a JPEG/PNG/GIF/WebP file (max 10MB)"
                },
                {
                  "key": "eventType",
                  "value": "wedding",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/api/uploadImages",
            "description": "Multipart form-data. Do not set Content-Type manually."
          }
        },
        {
          "name": "Delete Image (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
