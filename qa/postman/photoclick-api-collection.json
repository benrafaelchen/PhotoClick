{
  "info": {
    "_postman_id": "a1b2c3d4-photoclick-qa-collection",
    "name": "PhotoClick API",
    "description": "Manual API test collection for PhotoClick (Express backend). Aligned with be/routes/api.js.\n\n**Setup:**\n1. Set collection variable `baseUrl` (default http://localhost:8801)\n2. Run Sign In requests; token is saved to `authToken`\n3. Use Bearer auth on protected routes (collection inherits Authorization where configured)\n\n**No real secrets** — use your own test accounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8801",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testOrderNumber",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Sign In (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) {",
                  "    pm.collectionVariables.set('customerToken', json.token);",
                  "    pm.collectionVariables.set('authToken', json.token);",
                  "  }",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"customer.example@test.com\",\n  \"userPassword\": \"TestPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/signin",
            "description": "Replace email/password with a valid customer test account."
          }
        },
        {
          "name": "Sign In (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('authToken', json.token);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"admin.example@test.com\",\n  \"userPassword\": \"TestPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/signin",
            "description": "Use a seeded admin account from photodb (RoleID 1)."
          }
        },
        {
          "name": "Sign In (Photographer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('authToken', json.token);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"photographer.example@test.com\",\n  \"userPassword\": \"TestPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/signin"
          }
        },
        {
          "name": "Sign Up (Customer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newcustomer.example@test.com\",\n  \"personalId\": \"999888777\",\n  \"password\": \"TestPass123\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Customer\",\n  \"phoneNumber\": \"0501234567\",\n  \"address\": \"123 Test Street, Tel Aviv\",\n  \"roleID\": 2,\n  \"roleName\": \"Customer\"\n}"
            },
            "url": "{{baseUrl}}/api/signup"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userEmail\": \"customer.example@test.com\"\n}"
            },
            "url": "{{baseUrl}}/api/forgotpassword"
          }
        },
        {
          "name": "Google Sign In",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"<GOOGLE_ID_TOKEN_PLACEHOLDER>\"\n}"
            },
            "url": "{{baseUrl}}/api/google-signin",
            "description": "Requires valid Google ID token and pre-registered user."
          }
        }
      ]
    },
