# PhotoClick Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8801

# Database (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=photodb

# JWT Secret (generate a strong random string for production)
JWT_SECRET=change-me-to-a-strong-random-string

# Email (Gmail App Password - generate from Google Account > Security > App Passwords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Admin notification emails (comma-separated)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Frontend URL (used in email links)
SITE_URL=http://localhost:3000

# Google OAuth (optional - for Google Sign-In)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
