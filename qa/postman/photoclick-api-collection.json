    {
      "name": "04 - Orders (Customer)",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created or success', () => {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{customerToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"Wedding Party\",\n  \"packStyle\": \"bronze\",\n  \"serialPack\": 201,\n  \"eventDate\": \"2026-08-15\",\n  \"eventTime\": \"18:00\",\n  \"eventPrice\": 2850,\n  \"place\": { \"name\": \"Test Venue Hall\" },\n  \"quantities\": {},\n  \"dynamicDescription\": \"Includes: 1 Photographers Stills, 1 Photographers Video, 2 Albums (30X80 CM), 500 Magnets (10X12 CM).\"\n}"
            },
            "url": "{{baseUrl}}/api/createOrder",
            "description": "Uses customerToken. Sign in as customer first."
          }
        },
        {
          "name": "Get User Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{customerToken}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/getUserOrders"
          }
        }
      ]
    },
